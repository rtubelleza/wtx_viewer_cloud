# Staging tier. Copy to staging.tfvars (gitignored) and fill the <...> fields.
# Use with backend key staging/terraform.tfstate, see ardcnectar/README.md.
instance_name         = "wtx-viewer-staging"
app_domain            = "staging.nsclc-spatial-atlas.cloud.edu.au."
swift_container       = "staging"
admin_email           = "<admin email>"
ssh_ingress_cidr      = "<admin IP>/32"
app_https_cidr        = "<admin IP>/32"
manage_github_secrets = false # true would make staging own the repo-level SSH_PUBLIC_KEY that prod already writes (github.tf)
github_environment    = "staging"
